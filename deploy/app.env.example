# /opt/travel-gd/etc/app.env  (mode 0600, owned by root)
# Real values are generated on the server by deploy/server-setup.sh.
# Never commit a filled-in copy of this file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=travel_gd
DB_USER=travelgd_app
DB_PASSWORD=__GENERATED_ON_SERVER__
JWT_SECRET=__GENERATED_ON_SERVER__
JWT_EXPIRE_HOURS=72
DASHSCOPE_API_KEY=
TENCENT_MAP_API_KEY=
# Text model for route generation, blog drafts and the guide chat.
AI_MODEL=qwen-plus
# AMap Web service key (different from the browser JS API key).
# Empty -> the backend falls back to TENCENT_MAP_API_KEY.
AMAP_WEB_KEY=
AMAP_ROUTE_URL=https://restapi.amap.com/v3/direction
AMAP_TRANSIT_CITY=广州
PORT=18080
HOST=127.0.0.1
GIN_MODE=release
