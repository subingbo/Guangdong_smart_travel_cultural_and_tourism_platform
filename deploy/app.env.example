# /opt/travel-gd/etc/app.env  (mode 0600, owned by root)
# Real values are generated on the server by deploy/server-setup.sh.
# Never commit a filled-in copy of this file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=travel_gd
DB_USER=travelgd_app
DB_PASSWORD=__GENERATED_ON_SERVER__
JWT_SECRET=__GENERATED_ON_SERVER__
JWT_EXPIRE_HOURS=72
DASHSCOPE_API_KEY=
TENCENT_MAP_API_KEY=
# Text model for route generation, blog drafts and the guide chat.
AI_MODEL=qwen-plus
# OpenAI-compatible endpoint used by the agent (tools + streaming).
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_STREAM=true
# AMap **Web服务** key (NOT the browser Web端/JS API key).
# The JS API key + security code belong in web/.env.local instead.
# Empty -> TENCENT_MAP_API_KEY for route geometry, straight-line estimates
# for agent travel times, and get_weather returns "not configured".
# This backend does not implement AMap's optional
# digital-signature (sig) requests, so use a Web服务 key without 数字签名.
AMAP_WEB_KEY=
AMAP_ROUTE_URL=https://restapi.amap.com/v3/direction
AMAP_WEATHER_URL=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_TRANSIT_CITY=广州
PORT=18080
HOST=127.0.0.1
GIN_MODE=release
# Blog images and avatars are written here (nginx serves it at /uploads/).
UPLOAD_DIR=/opt/travel-gd/uploads

# --- AI agent -------------------------------------------------------------
# Keep disabled until DASHSCOPE_API_KEY is configured.
AGENT_ENABLED=true
# spawn = one goroutine per run + running/admission semaphores (recommended).
# fixed = bounded worker pool, used for the A/B benchmark and as a fallback.
AGENT_EXECUTOR_MODE=spawn
AGENT_MAX_CONCURRENT_RUNS=4
AGENT_QUEUE_CAPACITY=16
AGENT_QUEUE_TIMEOUT_SECONDS=30
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS_PER_STEP=3
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_HISTORY_MESSAGES=12
AGENT_MAX_OUTPUT_BYTES=65536
AGENT_MAX_ARGUMENTS_BYTES=16384
AGENT_MAX_TOOL_RESULT_BYTES=16384
AGENT_RATE_LIMIT_PER_MINUTE=10
AGENT_MAP_CONCURRENCY=8
AGENT_DEBUG=false

# Keep the DB pool >= AGENT_MAX_CONCURRENT_RUNS.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30
