# /etc/systemd/system/travel-gd.service
# Runs the Go backend (server-go) on loopback only; nginx is the public entry.
[Unit]
Description=Travel Guangdong Go backend
Documentation=file:///opt/travel-gd/README.md
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=travelgd
Group=travelgd
WorkingDirectory=/opt/travel-gd
EnvironmentFile=/opt/travel-gd/etc/app.env
# Keep the Go heap below the cgroup limit; AGENT_MAX_CONCURRENT_RUNS=4 keeps
# the agent's LLM/AMap concurrency in line with a 2C1G host.
Environment=GOMEMLIMIT=300MiB
ExecStart=/opt/travel-gd/bin/travel-gd-server
Restart=always
RestartSec=5
TimeoutStopSec=15
SuccessExitStatus=143
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Blog images and avatars are written here at runtime.
ReadWritePaths=/opt/travel-gd/uploads
# 2C1G host shared with another service: hard cap so a leak cannot take the box down.
# The agent added SSE buffers, plan JSON and up to 4 in-flight runs, so the
# cap is 384M with GOMEMLIMIT=300MiB as the soft signal.
MemoryMax=384M

[Install]
WantedBy=multi-user.target
