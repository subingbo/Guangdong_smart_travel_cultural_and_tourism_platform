# Copy to .env (same folder as docker-compose.yml) and fill in real values.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
TENCENT_MAP_API_KEY=
AI_MODEL=qwen-plus
# Vision model for menu OCR / translation (qwen3-vl-plus works on most accounts).
AI_VISION_MODEL=qwen3-vl-plus
# WeChat mini-program login. Leave empty for local dev: the backend then derives
# a stable guest account from the client deviceId.
WX_APPID=
WX_SECRET=
# AMap Web service key (server-side). The browser JS API key lives in web/.env.local.
AMAP_WEB_KEY=
AMAP_ROUTE_URL=https://restapi.amap.com/v3/direction
AMAP_WEATHER_URL=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_TRANSIT_CITY=广州
