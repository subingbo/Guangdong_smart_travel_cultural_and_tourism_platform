# Copy to .env (same folder as docker-compose.yml) and fill in real values.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
TENCENT_MAP_API_KEY=
AI_MODEL=qwen-plus
# AMap Web service key (server-side). The browser JS API key lives in web/.env.local.
AMAP_WEB_KEY=
AMAP_ROUTE_URL=https://restapi.amap.com/v3/direction
AMAP_TRANSIT_CITY=广州
