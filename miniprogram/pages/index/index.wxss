.page {
  background-color: #f6f6f6;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.header {
  background-color: #0052D9;
  color: #fff;
  padding: 48rpx 32rpx 32rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  margin-bottom: 32rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
}

.subtitle {
  font-size: 24rpx;
  color: #e6e6e6;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.lang-btn {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.section {
  padding: 0 32rpx;
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.recommend-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.card-content {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Swiper Styles */
.home-swiper {
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.swiper-content {
  position: relative;
  width: 100%;
  height: 100%;
}

.image-card {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.5);
  padding: 16rpx;
  color: #fff;
  text-align: center;
  backdrop-filter: blur(4px);
}
