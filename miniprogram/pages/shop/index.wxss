.page {
  background-color: #f6f6f6;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.header {
  background-color: #0052D9;
  color: #fff;
  padding: 40rpx 32rpx 32rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  margin-bottom: 32rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
}

.search-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.banner {
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 320rpx;
}

.recommend-list {
  display: flex;
  gap: 20rpx;
}

.recommend-card {
  flex: 1;
  min-width: 0;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.recommend-img {
  width: 100%;
  height: 220rpx;
}

.recommend-info {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recommend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  color: #0052D9;
  font-size: 30rpx;
  font-weight: 700;
}

.bottom-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
}

.bottom-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sum {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.count {
  font-size: 22rpx;
  color: #999;
}
