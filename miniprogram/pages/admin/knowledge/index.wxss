.page {
  background-color: #f6f6f6;
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background-color: #fff;
  border-bottom: 2rpx solid #f0f0f0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.filter-bar {
  padding: 24rpx 32rpx;
  background-color: #fff;
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-item {
  flex-shrink: 0;
}

.list {
  padding: 32rpx;
}

.item-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.item-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background-color: #eee;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-right: 16rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.item-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-sub {
  font-size: 22rpx;
  color: #999;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
}

.item-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
