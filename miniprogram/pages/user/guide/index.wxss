.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.map-context {
  height: 35vh;
  width: 100%;
  position: relative;
}

.guide-map {
  width: 100%;
  height: 100%;
}

.location-label {
  position: absolute;
  bottom: 32rpx;
  left: 32rpx;
  background-color: rgba(255,255,255,0.9);
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  backdrop-filter: blur(4px);
}

.chat-container {
  flex: 1;
  background-color: #fff;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  margin-top: -48rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.1);
}

.handle {
  width: 96rpx;
  height: 12rpx;
  background-color: #eee;
  border-radius: 6rpx;
  margin: 16rpx auto;
}

.chat-list {
  flex: 1;
  padding: 32rpx;
  box-sizing: border-box;
}

.message-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
  gap: 16rpx;
}

.row-reverse {
  flex-direction: row-reverse;
}

.bubble {
  padding: 24rpx;
  border-radius: 16rpx;
  max-width: 70%;
  font-size: 28rpx;
  line-height: 1.5;
}

.bubble-bot {
  background-color: #f6f6f6;
  color: #333;
  border-top-left-radius: 4rpx;
}

.bubble-user {
  background-color: #0052D9;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.msg-image-container {
  margin-top: 16rpx;
}

.msg-image {
  width: 100%;
  border-radius: 8rpx;
  display: block;
}

.msg-note {
  font-size: 20rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.footer {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  /* Add extra padding for TabBar */
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  border-top: 2rpx solid #eee;
}
