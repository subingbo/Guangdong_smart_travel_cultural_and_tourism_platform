.page {
  background-color: #f6f6f6;
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  background-color: #fff;
  padding: 32rpx;
  margin: -32rpx -32rpx 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
}

.create-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.upload-area {
  border: 4rpx dashed #eee;
  border-radius: 16rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fafafa;
}

.upload-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.upload-subtext {
  font-size: 24rpx;
  color: #ccc;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.blog-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.blog-img-container {
  position: relative;
}

.location-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background-color: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
}

.blog-content {
  padding: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.username {
  font-size: 24rpx;
  color: #666;
  margin-left: 16rpx;
}

.dot {
  font-size: 24rpx;
  color: #ccc;
  margin: 0 8rpx;
}

.time {
  font-size: 24rpx;
  color: #ccc;
}

.blog-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.blog-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.actions {
  display: flex;
  align-items: center;
}

.action-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-right: 32rpx;
}

.share {
  margin-left: auto;
  margin-right: 0;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.img-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
  background: #fafafa;
}

.img-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 32rpx;
  border-radius: 0 0 0 16rpx;
}

.topic-row {
  margin-top: 24rpx;
}

.topic-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d8dee9;
  border-radius: 14rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.draft-title {
  width: 100%;
  height: 84rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d8dee9;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.draft-content {
  width: 100%;
  min-height: 240rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #d8dee9;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.draft-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.draft-actions t-button {
  flex: 1;
}

.avatar-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.action-item.liked {
  color: #e34d59;
}

.empty-feed {
  text-align: center;
  padding: 64rpx 0;
  color: #999;
  font-size: 26rpx;
}
