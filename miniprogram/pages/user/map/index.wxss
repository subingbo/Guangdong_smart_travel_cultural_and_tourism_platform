.page {
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.map-container {
  width: 100%;
  height: 100vh;
  position: relative;
}

.route-map {
  width: 100%;
  height: 100%;
}

.map-bg {
  width: 100%;
  height: 100%;
  background-color: #eee;
  position: relative;
}

.map-img {
  width: 100%;
  height: 100%;
  opacity: 0.8;
  filter: grayscale(100%);
}

.marker {
  width: 60rpx;
  height: 60rpx;
  background-color: #0052D9;
  border: 6rpx solid #fff;
  border-radius: 50% 50% 0 50%;
  transform: rotate(45deg);
  position: absolute;
  box-shadow: 0 8rpx 12rpx rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.marker-text {
  transform: rotate(-45deg);
  color: #fff;
  font-weight: bold;
  font-size: 24rpx;
}

.marker-label {
  position: absolute;
  background-color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.2);
  white-space: nowrap;
  z-index: 20;
}

.header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  pointer-events: none;
}

.back-btn, .share-btn {
  background-color: #fff;
  padding: 16rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title-card {
  background-color: rgba(255,255,255,0.9);
  backdrop-filter: blur(10px);
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  pointer-events: auto;
}

.title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 20rpx;
  color: #999;
}

.bottom-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  padding: 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.1);
  z-index: 30;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.drag-handle-area {
  width: 100%;
  padding: 32rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.handle {
  width: 96rpx;
  height: 12rpx;
  background-color: #eee;
  border-radius: 6rpx;
}

.smooth-transition {
  transition: height 0.3s cubic-bezier(0.25, 0.8, 0.5, 1);
}

.timeline-scroll {
  flex: 1;
  height: 0;
  width: 100%;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  position: relative;
}

.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 80rpx;
  left: 40rpx;
  bottom: -40rpx;
  width: 4rpx;
  background-color: #f0f0f0;
}

.timeline-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  z-index: 1;
}

.bg-blue { background-color: #e8f3ff; }
.bg-orange { background-color: #fff3e8; }
.bg-purple { background-color: #f2efff; }

.timeline-content {
  flex: 1;
}

.timeline-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.timeline-desc {
  font-size: 28rpx;
  color: #666;
  background-color: #f9f9f9;
  padding: 16rpx;
  border-radius: 16rpx;
}
