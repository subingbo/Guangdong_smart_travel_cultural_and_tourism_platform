.page {
  padding: 32rpx;
  background-color: #f6f6f6;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.map-card {
  padding: 0;
  overflow: hidden;
}

.preview-map {
  width: 100%;
  height: 360rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.pace-selector {
  display: flex;
  background-color: #f3f3f3;
  border-radius: 16rpx;
  padding: 8rpx;
}

.pace-option {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
}

.pace-option.active {
  background-color: #fff;
  color: #0052D9;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.btn-area {
  margin-top: 48rpx;
}
