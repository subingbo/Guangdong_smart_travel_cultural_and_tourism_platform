<view class="login-page">
  <view class="hero">
    <view class="hero-title">{{t.appName || '粤游广东'}}</view>
    <view class="hero-sub">{{mode === 'login' ? '欢迎回来，请登录继续' : '新用户注册'}}</view>
  </view>

  <view class="mode-switch">
    <view class="mode-item {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="onModeSwitch">登录</view>
    <view class="mode-item {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="onModeSwitch">注册</view>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">账号</text>
      <input class="input" placeholder="用户名（演示账号 demo）" value="{{username}}" bindinput="onUsername" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password placeholder="密码（演示账号 demo123）" value="{{password}}" bindinput="onPassword" />
    </view>
    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="label">昵称</text>
      <input class="input" placeholder="展示昵称（可选）" value="{{nickname}}" bindinput="onNickname" />
    </view>

    <button class="submit-btn" type="primary" loading="{{submitting}}" bindtap="onSubmit">
      {{mode === 'login' ? '登录' : '注册并登录'}}
    </button>

    <view class="divider"><text>或</text></view>

    <button class="wechat-btn" loading="{{submitting}}" bindtap="onWechatLogin">微信一键登录</button>
    <view class="hint">演示环境无需微信密钥，自动创建并记住你的游客身份</view>
  </view>
</view>
