.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef4ff 0%, #f7f9fc 40%, #f7f9fc 100%);
  padding: 96rpx 48rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  margin-bottom: 64rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a2233;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.mode-switch {
  display: flex;
  background: #e8edf5;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}

.mode-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #4b5563;
  border-radius: 12rpx;
}

.mode-item.active {
  background: #ffffff;
  color: #0052d9;
  font-weight: 600;
}

.form {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(16, 42, 100, 0.08);
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d8dee9;
  border-radius: 14rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 16rpx;
  background: #0052d9;
  color: #fff;
  border-radius: 14rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 36rpx 0 24rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e5e7eb;
}

.divider text {
  padding: 0 24rpx;
}

.wechat-btn {
  background: #07c160;
  color: #fff;
  border-radius: 14rpx;
}

.hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}
