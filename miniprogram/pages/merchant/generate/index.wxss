.page {
  background-color: #f6f6f6;
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  transition: all 0.2s;
}

.active-tag {
  background-color: #ecf2fe !important;
  color: #0052D9 !important;
  border: 1px solid #0052D9;
}

.btn-area {
  margin-top: 48rpx;
  margin-bottom: 48rpx;
}

.result-area {
  margin-top: 48rpx;
  padding-bottom: 100rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.lang-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #0052D9;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-bottom-left-radius: 12rpx;
  border-top-right-radius: 16rpx;
}

.result-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
}
