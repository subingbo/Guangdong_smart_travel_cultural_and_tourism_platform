.page,
page {
  height: 100%;
  overflow: hidden;
}

.page {
  height: 100vh;
  background-color: #000;
  display: flex;
  flex-direction: column;
}

.header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  padding-top: 100rpx; 
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
  color: #fff;
}

.title {
  font-size: 28rpx;
  background-color: rgba(0,0,0,0.3);
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(10px);
}

.camera-container {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.camera-preview {
  width: 100%;
  height: 100%;
}

.camera-img {
  width: 100%;
  height: 100%;
  opacity: 0.8;
}

.scan-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500rpx;
  height: 500rpx;
  border-radius: 24rpx;
}

.corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-color: #0052D9;
  border-style: solid;
  border-width: 0;
}

.top-left { top: 0; left: 0; border-top-width: 6rpx; border-left-width: 6rpx; border-top-left-radius: 24rpx; }
.top-right { top: 0; right: 0; border-top-width: 6rpx; border-right-width: 6rpx; border-top-right-radius: 24rpx; }
.bottom-left { bottom: 0; left: 0; border-bottom-width: 6rpx; border-left-width: 6rpx; border-bottom-left-radius: 24rpx; }
.bottom-right { bottom: 0; right: 0; border-bottom-width: 6rpx; border-right-width: 6rpx; border-bottom-right-radius: 24rpx; }

.scan-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background-color: #0052D9;
  box-shadow: 0 0 10rpx #0052D9;
  animation: scan 2s infinite linear;
}

@keyframes scan {
  0% { top: 0; opacity: 0; }
  100% { top: 100%; opacity: 0; }
}

.detected-overlay {
  position: absolute;
  top: 35%;
  left: 35%;
  background-color: rgba(255,255,255,0.9);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
  backdrop-filter: blur(4px);
  transform: translate(-50%, -50%);
}

.ocr-box {
  position: absolute;
  border: 2rpx solid rgba(0, 82, 217, 0.5);
  background-color: rgba(0, 82, 217, 0.1);
  z-index: 5;
}

.explanation-card {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50vh;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx;
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
}

.explanation-card.show {
  transform: translateY(0);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.card-content {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tag {
  background-color: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.controls-panel {
  background-color: #000;
  padding: 48rpx 64rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  margin-top: -32rpx;
  z-index: 20;
}

.control-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  background-color: #333;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 8rpx;
}

.control-text {
  font-size: 20rpx;
  color: #999;
}

.shutter-btn {
  width: 128rpx;
  height: 128rpx;
  border: 8rpx solid #fff;
  border-radius: 50%;
  padding: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.shutter-inner {
  width: 100%;
  height: 100%;
  background-color: #fff;
  border-radius: 50%;
}

/* Overlay Container (Word Cloud) - Kept for fallback or alternative mode */
.overlay-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 50;
  display: flex;
  flex-direction: column;
}

.overlay-header {
  padding: 32rpx;
  padding-top: 100rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.overlay-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.cloud-content {
  flex: 1;
  position: relative;
  width: 100%;
}

.cloud-tag {
  padding: 8rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
  font-weight: bold;
  white-space: nowrap;
  transition: transform 0.2s;
}

.cloud-tag:active {
  transform: translate(-50%, -50%) scale(1.1);
}

/* Culture Card Overlay */
.card-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.culture-card {
  width: 90%; /* Make it slightly narrower to look more centered */
  /* max-height: 80vh; Remove max-height to allow manual resize, or keep as upper bound logic in JS */
  max-height: 80vh;
  height: auto;
  background-color: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2);
  transition: height 0.05s linear; /* Smooth resize */
}

.cc-loading {
  padding: 40rpx;
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cc-resize-handle {
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #fafafa;
  border-top: 1rpx solid #eee;
  flex-shrink: 0;
}

.handle-bar {
  width: 80rpx;
  height: 8rpx;
  background-color: #ddd;
  border-radius: 4rpx;
}

.cc-header {
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cc-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #000;
  margin-right: 24rpx;
}

.cc-body {
  padding: 40rpx 48rpx;
  padding-bottom: 80rpx; /* Ensure text isn't cut off at bottom */
  flex: 1;
  overflow-y: auto; /* Enable scrolling for standard view */
  min-height: 200rpx;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.cc-section {
  margin-bottom: 40rpx;
}

.cc-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #666;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  border-left: 6rpx solid #0052D9;
  padding-left: 12rpx;
}

.cc-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-wrap: break-word;
  word-break: break-word;
  text-align: left;
}

.cc-stream {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.cc-tag {
  background-color: #e6f7ff;
  color: #1890ff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* Keyword Drawer */
.keyword-drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  z-index: 40; /* Above camera but below cards */
  transition: height 0.1s linear; /* Smooth drag */
}

.drawer-handle-bar {
  width: 100%;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  /* Increase touch target */
  padding: 10rpx 0; 
}

.drawer-handle {
  width: 80rpx;
  height: 8rpx;
  background-color: #ddd;
  border-radius: 4rpx;
}

.drawer-header {
  padding: 0 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.drawer-content {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx 32rpx 32rpx;
}

.keywords-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.keyword-chip {
  padding: 12rpx 24rpx;
  border: 2rpx solid transparent;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.keyword-chip:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #0052D9;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
