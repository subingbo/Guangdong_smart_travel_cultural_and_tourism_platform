.page {
  background-color: #f6f6f6;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.header {
  padding: 32rpx;
  background-color: #fff;
}

.welcome-card {
  background: linear-gradient(90deg, #0052D9 0%, #366EF4 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 82, 217, 0.2);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 24rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
}

.tag {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.section {
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.analytics-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.analytics-item {
  text-align: center;
}

.label {
  font-size: 24rpx;
  color: #999;
}

.value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-top: 8rpx;
}

.divider {
  width: 2rpx;
  height: 64rpx;
  background-color: #eee;
}
