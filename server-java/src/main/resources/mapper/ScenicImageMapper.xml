<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travelgd.mapper.ScenicImageMapper">

    <select id="findAll" resultType="com.travelgd.model.ScenicImage">
        SELECT * FROM scenic_images ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findById" resultType="com.travelgd.model.ScenicImage">
        SELECT * FROM scenic_images WHERE id = #{id}
    </select>
</mapper>
