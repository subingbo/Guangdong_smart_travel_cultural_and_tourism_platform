# API base URL for the built website.
# - Empty string: use same-origin /api (works behind the compose Nginx, and with the Vite dev proxy).
# - Or point directly at one backend, e.g. http://localhost:8081 for the Go twin.
VITE_API_BASE_URL=

# AMap Web端(JS API) key + security code. Fill these in a local .env.local file
# (gitignored); leave empty here. The map shows a configuration hint when absent.
VITE_AMAP_JS_KEY=
VITE_AMAP_JS_SECURITY_CODE=
