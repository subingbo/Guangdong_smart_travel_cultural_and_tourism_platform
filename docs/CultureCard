## 4. JS 逻辑实现（坐标转换）

在 `onImageLoad` 事件中获取图片在手机屏幕上的实际显示尺寸，然后计算系数。

```javascript
Page({
  data: {
    wordsList: [], // 存储处理后的词块
    ocrFinished: false,
    viewWidth: 0,
    viewHeight: 0
  },

  // 图片加载完成，获取实际显示尺寸
  onImageLoad(e) {
    const { width, height } = e.detail; // 图片原始尺寸
    
    // 获取屏幕宽度 (rpx转px)
    const sysInfo = wx.getSystemInfoSync();
    const screenWidth = sysInfo.windowWidth;

    // 因为 image 组件用了 mode="widthFix"，所以高度会等比缩放
    const scale = screenWidth / width; 
    const viewHeight = height * scale;

    this.setData({
      viewWidth: screenWidth,
      viewHeight: viewHeight,
      scale: scale
    });
  },

  // 处理 OCR 返回的数据
  processOcrData(ocrItems) {
    const scale = this.data.scale;
    const processed = ocrItems.map(item => {
      // 假设 OCR 返回的坐标字段为 item.pos (包含 left, top, width, height)
      return {
        text: item.text,
        canvasLeft: item.pos.left * scale,
        canvasTop: item.pos.top * scale,
        canvasWidth: item.pos.width * scale,
        canvasHeight: item.pos.height * scale
      };
    });

    this.setData({
      wordsList: processed,
      ocrFinished: true
    });
  },

  // 点击单词
  onWordTap(e) {
    const word = e.currentTarget.dataset.word;
    wx.showLoading({ title: '探索文化中...' });
    
    // 调用云函数执行 Qwen 模型
    wx.cloud.callFunction({
      name: 'generateCard',
      data: { word: word },
      success: res => {
        this.setData({
          currentCard: res.result.data,
          showCard: true
        });
      },
      complete: () => wx.hideLoading()
    });
  }
});

```

