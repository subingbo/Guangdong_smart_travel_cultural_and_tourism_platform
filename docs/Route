#### 交互逻辑实现
```javascript
// travelBlog.js
Page({
  data: {
    images: [],
    generating: false,
    blogTitle: '',
    blogContent: '',
    blogDate: '',
    routeId: null
  },
  
  onLoad(options) {
    // 获取路由参数
    this.setData({ routeId: options.routeId });
  },
  
  // 选择图片
  chooseImage() {
    wx.chooseMedia({
      count: 9 - this.data.images.length,
      mediaType: ['image'],
      sourceType: ['album', 'camera'],
      success: (res) => {
        const newImages = res.tempFiles.map(file => file.tempFilePath);
        this.setData({
          images: [...this.data.images, ...newImages]
        });
      }
    });
  },
  
  // 删除图片
  deleteImage(e) {
    const index = e.currentTarget.dataset.index;
    const images = [...this.data.images];
    images.splice(index, 1);
    this.setData({ images });
  },
  
  // 生成游记
  async generateBlog() {
    if (this.data.images.length === 0) {
      wx.showToast({
        title: '请先上传照片',
        icon: 'none'
      });
      return;
    }
    
    this.setData({ generating: true });
    
    try {
      // 1. 上传图片到云存储
      const imageUrls = await this.uploadImages();
      
      // 2. 获取路线信息
      const routeInfo = await this.getRouteInfo();
      
      // 3. 调用AI生成英文游记
      const blogResult = await wx.cloud.callFunction({
        name: 'generateTravelBlog',
        data: {
          images: imageUrls,
          routeInfo: routeInfo,
          style: 'vivid' // 生动风格
        }
      });
      
      // 4. 保存到数据库
      const blogId = await this.saveBlogToDB({
        title: blogResult.data.title,
        content: blogResult.data.content,
        images: imageUrls,
        routeId: this.data.routeId
      });
      
      // 5. 更新页面显示
      this.setData({
        blogTitle: blogResult.data.title,
        blogContent: blogResult.data.content,
        blogDate: new Date().toLocaleDateString(),
        generating: false
      });
      
      wx.showToast({
        title: '游记生成成功',
        icon: 'success'
      });
      
    } catch (error) {
      console.error('生成游记失败:', error);
      wx.showToast({
        title: '生成失败，请重试',
        icon: 'none'
      });
      this.setData({ generating: false });
    }
  },
  
  // 上传图片
  uploadImages() {
    const uploadPromises = this.data.images.map((imagePath, index) => {
      const cloudPath = `travel-blogs/${Date.now()}-${index}.jpg`;
      
      return wx.cloud.uploadFile({
        cloudPath,
        filePath: imagePath
      }).then(res => res.fileID);
    });
    
    return Promise.all(uploadPromises);
  },
  
  // 获取路线信息
  async getRouteInfo() {
    if (!this.data.routeId) return null;
    
    const db = wx.cloud.database();
    const result = await db.collection('routes').doc(this.data.routeId).get();
    return result.data;
  },
  
  // 保存到数据库
  async saveBlogToDB(blogData) {
    const db = wx.cloud.database();
    const result = await db.collection('travelBlogs').add({
      data: {
        ...blogData,
        userId: this.getUserId(),
        createdAt: db.serverDate(),
        likes: 0,
        shares: 0
      }
    });
    
    return result._id;
  },
  
  // 获取用户ID
  getUserId() {
    // 实际应从用户信息获取
    return wx.getStorageSync('openid') || 'anonymous';
  },
  
  // 复制内容
  copyBlog() {
    wx.setClipboardData({
      data: `${this.data.blogTitle}\n\n${this.data.blogContent}`,
      success: () => {
        wx.showToast({
          title: '已复制到剪贴板',
          icon: 'success'
