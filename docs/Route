### 7.3 RAG检索服务
```javascript
// cloudfunctions/rag-service/index.js
const cloud = require('wx-server-sdk');
cloud.init({ env: cloud.DYNAMIC_CURRENT_ENV });

// 引入向量数据库服务（以腾讯云向量数据库为例）
const vectorDB = require('./vector-db');

exports.search = async ({ query, poiId, location, limit = 5 }) => {
  try {
    // 1. 查询向量数据库
    const vectorResults = await vectorDB.search({
      query,
      filter: poiId ? { poiId } : {},
      limit: limit * 2 // 多查一些用于后续筛选
    });
    
    // 2. 根据位置距离排序
    const sortedResults = location
      ? sortByDistance(vectorResults, location)
      : vectorResults;
    
    // 3. 去重和筛选
    const uniqueResults = removeDuplicates(sortedResults);
    
    // 4. 返回最相关的结果
    return uniqueResults.slice(0, limit);
    
  } catch (error) {
    console.error('RAG检索失败:', error);
    return [];
  }
};

// 根据距离排序
function sortByDistance(results, location) {
  return results.sort((a, b) => {
    const distA = calculateDistance(
      location.latitude,
      location.longitude,
      a.latitude,
      a.longitude
    );
    const distB = calculateDistance(
      location.latitude,
      location.longitude,
      b.latitude,
      b.longitude
    );
    return distA - distB;
  });
}

// 去重
function removeDuplicates(results) {
  const seen = new Set();
  return results.filter(item => {
    const key = `${item.poiId}-${item.contentHash}`;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

// 计算距离（简化版）
function calculateDistance(lat1, lon1, lat2, lon2) {
  const R = 6371; // 地球半径（公里）
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
}
```

