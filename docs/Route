### 7.1 智能路线生成云函数
```javascript
// cloudfunctions/generateSmartRoute/index.js
const cloud = require('wx-server-sdk');
cloud.init({ env: cloud.DYNAMIC_CURRENT_ENV });

// 引入腾讯地图MCP服务
const mcpService = require('./mcp-service');

exports.main = async (event, context) => {
  const { location, interests, availableHours, date } = event;
  
  try {
    // 1. 根据兴趣标签搜索相关POI
    const pois = await searchPOIsByInterests(location, interests);
    
    // 2. 使用AI算法优化路线
    const optimizedRoute = await optimizeRoute(pois, availableHours);
    
    // 3. 获取路线规划详情
    const routeDetails = await getRouteDetails(optimizedRoute);
    
    // 4. 生成文化解说内容
    const enrichedRoute = await enrichWithCulturalInfo(routeDetails);
    
    // 5. 检查天气并生成备选路线
    const weather = await checkWeather(date, location);
    const alternativeRoute = weather.includes('雨') 
      ? await generateIndoorRoute(enrichedRoute)
      : null;
    
    // 6. 保存到数据库
    const routeId = await saveRouteToDB({
      ...enrichedRoute,
      indoorAlternative: alternativeRoute,
      weatherCondition: weather
    });
    
    return {
      success: true,
      routeId,
      message: '路线生成成功'
    };
    
  } catch (error) {
    console.error('路线生成失败:', error);
    return {
      success: false,
      error: error.message
    };
  }
};

// 根据兴趣搜索POI
async function searchPOIsByInterests(location, interests) {
  const results = [];
  
  for (const interest of interests) {
    // 调用腾讯地图MCP搜索
    const pois = await mcpService.placeSearchNearby({
      location: `${location.latitude},${location.longitude}`,
      keyword: getKeywordByInterest(interest),
      radius: 5000 // 5公里范围内
    });
    
    results.push(...pois);
  }
  
  return results;
}

// 优化路线算法
async function optimizeRoute(pois, availableHours) {
  // 使用旅行商问题(TSP)变种算法
  // 考虑：距离、停留时间、兴趣匹配度、开放时间
  
  // 简化实现：按距离排序
  return pois
    .sort((a, b) => calculateDistance(a, b))
    .slice(0, Math.min(pois.length, Math.ceil(availableHours / 1.5))); // 每个点平均1.5小时
}

// 获取路线详情
async function getRouteDetails(waypoints) {
  if (waypoints.length < 2) return { waypoints, polyline: [] };
  
  const polyline = [];
  
  // 获取每段路线的规划
  for (let i = 0; i < waypoints.length - 1; i++) {
    const from = waypoints[i];
    const to = waypoints[i + 1];
    
    const route = await mcpService.directionDriving({
      from: `${from.latitude},${from.longitude}`,
      to: `${to.latitude},${to.longitude}`
    });
    
    polyline.push(...route.polyline);
  }
  
  return { waypoints, polyline };
}

// 丰富文化信息
async function enrichWithCulturalInfo(route) {
  const enrichedWaypoints = [];
  
  for (const poi of route.waypoints) {
    // 调用AI生成文化解说
    const description = await generateCulturalDescription(poi);
    
    enrichedWaypoints.push({
      ...poi,
      description,
      stayTime: calculateStayTime(poi.category, description.length)
    });
  }
  
  return { ...route, waypoints: enrichedWaypoints };
}

// 生成室内路线
async function generateIndoorRoute(originalRoute) {
  // 搜索室内景点替换室外景点
  const indoorPOIs = await mcpService.placeSearchNearby({
    location: `${originalRoute.waypoints[0].latitude},${originalRoute.waypoints[0].longitude}`,
    keyword: '博物馆|美术馆|商场|室内',
    radius: 5000
  });
  
  // 重新优化路线
  return optimizeRoute(indoorPOIs, originalRoute.availableHours);
}

// 保存路线到数据库
async function saveRouteToDB(routeData) {
  const db = cloud.database();
  const result = await db.collection('routes').add({
    data: {
      ...routeData,
      createdAt: db.serverDate(),
      status: 'active'
    }
  });
  
  return result._id;
}
```

