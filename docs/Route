#### 交互逻辑实现
```javascript
// map.js
Page({
  data: {
    longitude: 116.397455,
    latitude: 39.909187,
    scale: 14,
    markers: [],
    polyline: [],
    currentPOI: null,
    showWeatherAlert: false,
    routeData: null,
    mapContext: null
  },
  
  onLoad(options) {
    // 获取路由参数
    const routeId = options.routeId;
    
    // 初始化地图上下文
    this.mapContext = wx.createMapContext('myMap', this);
    
    // 加载路线数据
    this.loadRouteData(routeId);
    
    // 监听天气变化
    this.checkWeather();
  },
  
  // 加载路线数据
  async loadRouteData(routeId) {
    try {
      const db = wx.cloud.database();
      const result = await db.collection('routes').doc(routeId).get();
      
      this.setData({
        routeData: result.data,
        longitude: result.data.waypoints[0].longitude,
        latitude: result.data.waypoints[0].latitude
      });
      
      // 渲染标记点和路线
      this.renderMapData(result.data);
      
    } catch (error) {
      console.error('加载路线数据失败:', error);
    }
  },
  
  // 渲染地图数据
  renderMapData(routeData) {
    const markers = routeData.waypoints.map((poi, index) => ({
      id: index,
      latitude: poi.latitude,
      longitude: poi.longitude,
      title: poi.name,
      iconPath: '/images/marker.png',
      width: 30,
      height: 30,
      callout: {
        content: poi.name,
        color: '#333',
        fontSize: 14,
        borderRadius: 4,
        padding: 8,
        display: 'ALWAYS'
      }
    }));
    
    const polyline = [{
      points: routeData.polyline,
      color: '#5591af',
      width: 6,
      dottedLine: false
    }];
    
    this.setData({ markers, polyline });
    
    // 调整地图视野以显示所有标记点
    this.mapContext.includePoints({
      points: markers.map(m => ({
        latitude: m.latitude,
        longitude: m.longitude
      })),
      padding: [60, 60, 60, 60]
    });
  },
  
  // 标记点点击事件
  onMarkerTap(e) {
    const markerId = e.markerId;
    const poi = this.data.routeData.waypoints[markerId];
    
    this.setData({
      currentPOI: {
        ...poi,
        distance: this.calculateDistance(poi)
      }
    });
  },
  
  // 计算距离
  calculateDistance(poi) {
    // 简化距离计算，实际应使用腾讯地图API
    const R = 6371000; // 地球半径（米）
    const lat1 = this.data.latitude * Math.PI / 180;
    const lat2 = poi.latitude * Math.PI / 180;
    const dLat = (poi.latitude - this.data.latitude) * Math.PI / 180;
    const dLng = (poi.longitude - this.data.longitude) * Math.PI / 180;
    
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(lat1) * Math.cos(lat2) *
              Math.sin(dLng/2) * Math.sin(dLng/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    
    return Math.round(R * c);
  },
  
  // 检查天气
  async checkWeather() {
    try {
      // 调用腾讯地图MCP天气接口
      const weather = await wx.cloud.callFunction({
        name: 'mcpProxy',
        data: {
          tool: 'weather',
          params: {
            adcode: '110101', // 行政区划代码，需根据位置获取
            type: 'now'
          }
        }
      });
      
      // 如果下雨，切换到室内路线
      if (weather.data.weather.includes('雨')) {
        this.switchToIndoorRoute();
        this.setData({ showWeatherAlert: true });
      }
      
    } catch (error) {
      console.error('获取天气失败:', error);
    }
  },
  
  // 切换到室内路线
  switchToIndoorRoute() {
    if (!this.data.routeData.indoorAlternative) return;
    
    // 加载室内备选路线
    this.renderMapData(this.data.routeData.indoorAlternative);
  },
  
  // 导航到POI
  navigateToPOI() {
    if (!this.data.currentPOI) return;
    
    wx.openLocation({
      latitude: this.data.currentPOI.latitude,
      longitude: this.data.currentPOI.longitude,
      name: this.data.currentPOI.name,
      address: this.data.currentPOI.address || ''
    });
  },
  
  // AI导游讲解
  askAIGuide() {
    wx.navigateTo({
      url: `/pages/user/guide/index?poiId=${this.data.currentPOI.poiId}`
    });
  },
  
  // 关闭卡片
  closeCard() {
    this.setData({ currentPOI: null });
  }
});
```

