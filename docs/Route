#### 交互逻辑实现
```javascript
// routeInput.js
Page({
  data: {
    startTime: '09:00',
    endTime: '17:00',
    travelDate: '2024-12-01',
    interestTags: [
      { name: '历史古迹', selected: false },
      { name: '美食探店', selected: false },
      { name: '自然风光', selected: false },
      { name: '艺术文化', selected: false },
      { name: '购物休闲', selected: false },
      { name: '亲子娱乐', selected: false }
    ],
    loading: false
  },
  
  // 时间选择
  onStartTimeChange(e) {
    this.setData({ startTime: e.detail.value });
  },
  
  onEndTimeChange(e) {
    this.setData({ endTime: e.detail.value });
  },
  
  onDateChange(e) {
    this.setData({ travelDate: e.detail.value });
  },
  
  // 兴趣标签选择
  toggleInterest(e) {
    const index = e.currentTarget.dataset.index;
    const key = `interestTags[${index}].selected`;
    this.setData({
      [key]: !this.data.interestTags[index].selected
    });
  },
  
  // 生成路线
  async generateRoute() {
    this.setData({ loading: true });
    
    try {
      // 1. 获取用户当前位置
      const location = await this.getUserLocation();
      
      // 2. 获取选择的兴趣标签
      const selectedInterests = this.data.interestTags
        .filter(tag => tag.selected)
        .map(tag => tag.name);
      
      // 3. 计算可用时间（小时）
      const start = new Date(`${this.data.travelDate} ${this.data.startTime}`);
      const end = new Date(`${this.data.travelDate} ${this.data.endTime}`);
      const availableHours = (end - start) / (1000 * 60 * 60);
      
      // 4. 调用云函数生成智能路线
      const result = await wx.cloud.callFunction({
        name: 'generateSmartRoute',
        data: {
          location,
          interests: selectedInterests,
          availableHours,
          date: this.data.travelDate
        }
      });
      
      // 5. 跳转到地图页面
      wx.navigateTo({
        url: `/pages/user/map/index?routeId=${result.data.routeId}`
      });
      
    } catch (error) {
      console.error('生成路线失败:', error);
      wx.showToast({
        title: '生成失败，请重试',
        icon: 'none'
      });
    } finally {
      this.setData({ loading: false });
    }
  },
  
  // 获取用户位置
  getUserLocation() {
    return new Promise((resolve, reject) => {
      wx.getLocation({
        type: 'gcj02',
        success: (res) => {
          resolve({
            latitude: res.latitude,
            longitude: res.longitude
          });
        },
        fail: reject
      });
    });
  }
});
```

